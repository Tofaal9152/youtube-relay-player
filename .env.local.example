# Server-side settings; never prefix the relay key with NEXT_PUBLIC_.
RELAY_URL=http://127.0.0.1:4100
RELAY_API_KEY=replace-with-the-same-random-key-as-backend-API_KEY
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional public relay address for the connection panel when RELAY_URL is internal.
# PUBLIC_RELAY_URL=https://video.example.com/relay-api
