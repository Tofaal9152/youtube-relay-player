HOST=127.0.0.1
PORT=4100
# Must be reachable from the viewer's browser.
PUBLIC_URL=http://127.0.0.1:4100
API_KEY=replace-with-the-same-random-key-as-frontend-RELAY_API_KEY
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# This path is relative to the directory from which you run npm run backend.
YTDLP_PATH=./backend/bin/yt-dlp
# Optional: your own YouTube-only Netscape cookie export. Never commit it.
# YOUTUBE_COOKIES_FILE=./backend/youtube-cookies.txt
