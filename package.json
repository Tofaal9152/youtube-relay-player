{
  "name": "nightfury-stream",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "backend": "node --env-file=backend/.env backend/server.mjs",
    "test": "node --test backend/test/*.test.mjs",
    "setup": "node scripts/setup.mjs",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "dashjs": "5.3.0",
    "lucide-react": "^0.577.0",
    "next": "16.4.6",
    "next-video": "^2.8.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0"
  },
  "description": "A self-hosted Next.js video player with a lightweight Node.js DASH relay.",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  }
}
